<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Barra lateral indicadora de nivel de riesgo -->
        <View
            android:id="@+id/cardRiskBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="#D32F2F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila superior: Avatar, Handle, Tag de plataforma y Tiempo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/avatarIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#FFEBEE"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/contactHandle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diego_2025"
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/platformTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="#EDE7F6"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="INSTAGRAM DM"
                            android:textColor="#4A148C"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/categoryDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Grooming · Solicitud de secreto y fotos"
                        android:textColor="#C62828"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/eventTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace 25 min"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Recuadro de nivel de riesgo y confianza IA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/severityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D32F2F"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✱ Alto Riesgo"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/confidenceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confianza IA: 98%"
                    android:textColor="#616161"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Caja destacada del mensaje/fragmento sospechoso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF8F8"
                android:padding="12dp">

                <TextView
                    android:id="@+id/messageQuoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“No le digas a tus papás, es nuestro secreto... mándame una foto como la de ayer”"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Diagnóstico del patrón detectado -->
            <TextView
                android:id="@+id/patternText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Detección de patrones: Coerción emocional y aislamiento parental detectado."
                android:textColor="#616161"
                android:textSize="12sp" />

            <!-- Botón principal: Guía de conversación -->
            <Button
                android:id="@+id/btnConversationGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#2E236C"
                android:paddingVertical="10dp"
                android:text="💬  Guía de conversación (Cómo hablar con ella)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
