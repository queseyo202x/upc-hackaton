<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#211A49"
                android:textSize="28sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:text="🛡  Espacio de confianza"
                android:textColor="#17152B"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/dashboardButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:backgroundTint="#4B388F"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="♙"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola, Kira 👋"
                        android:textColor="#17152B"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Estoy aquí contigo"
                        android:textColor="#6C6780"
                        android:textSize="16sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#EDE9FF"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#277A72"
                    android:textSize="28sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_kira_lilac"
                android:orientation="vertical"
                android:padding="17dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="#4B388F"
                        android:gravity="center"
                        android:text="🛡"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu espacio, tus reglas"
                            android:textColor="#211A49"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Puedes pedir ayuda cuando quieras."
                            android:textColor="#625B71"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kira_lilac"
                android:gravity="center_vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="126dp"
                    android:layout_height="78dp"
                    android:background="#17152B"
                    android:gravity="center"
                    android:text="Kira\n• • • • •"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estoy aquí contigo"
                        android:textColor="#211A49"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Te cuido en silencio sin juzgarte."
                        android:textColor="#625B71"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="⚽ Apoyo rápido y ayuda"
                android:textColor="#17152B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kira_help"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Te sientes incómoda o insegura?"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Toca aquí para ver opciones directas y seguras"
                    android:textColor="#FFEAF1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kira_card"
                android:orientation="vertical"
                android:padding="17dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥  Mensaje clave de apoyo"
                    android:textColor="#4B388F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Avisar a mamá / papá"
                    android:textColor="#17152B"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F0EEFC"
                    android:padding="11dp"
                    android:text="“Necesito hablar contigo sobre algo que me pasó en redes 💜”"
                    android:textColor="#6C6780"
                    android:textSize="14sp"
                    android:textStyle="italic" />
                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kira_button"
                    android:text="▷  Enviar mensaje"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kira_card"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#C8F5EC"
                    android:gravity="center"
                    android:text="☏"
                    android:textColor="#16826D"
                    android:textSize="24sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Línea 1810"
                        android:textColor="#17152B"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIMP · Niños y Adolescentes"
                        android:textColor="#77738D"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#16826D"
                    android:text="☏ Llamar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kira_card"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#FFE1E5"
                    android:gravity="center"
                    android:text="▱"
                    android:textColor="#B0003A"
                    android:textSize="24sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Línea 100 / Chat 100"
                        android:textColor="#17152B"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atención gratuita 24/7"
                        android:textColor="#77738D"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#4B388F"
                    android:text="▤ Chat"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="▣ Aprende a cuidarte"
                android:textColor="#17152B"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historias y consejos fáciles de leer"
                android:textColor="#77738D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/learnCardSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kira_card"
                android:drawablePadding="12dp"
                android:padding="16dp"
                android:text="🚩  2 min de lectura   Alerta\n\nLa técnica del secreto: ¿Por qué te piden que no le cuentes a nadie?"
                android:textColor="#17152B"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/learnCardSocial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:text="🧑‍💻  Guía visual   Redes sociales\n\nPerfiles señuelo: cómo identificar fotos o identidades falsas en Instagram o TikTok"
                android:textColor="#17152B"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/learnCardPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:text="⚠  Paso a paso   Seguridad íntima\n\nQué hacer si te piden fotos íntimas o te amenazan con compartirlas"
                android:textColor="#17152B"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/messagesScroll"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/modelStatusContainer"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
